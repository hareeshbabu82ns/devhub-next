{
  "name": "devhub",
  "packageManager": "pnpm@9.12.0",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "db:gen": "prisma generate && node scripts/patch-prisma-turbopack.mjs",
    "postinstall": "node scripts/patch-prisma-turbopack.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "pwa:assets": "node scripts/generate-pwa-assets.mjs",
    "dev:emails": "email dev --dir src/components/emails --port 3008",
    "release:patch": "pnpm version patch && git push && git push --tags",
    "release:minor": "pnpm version minor && git push && git push --tags",
    "release:major": "pnpm version major && git push && git push --tags",
    "dict:import": "tsx src/lib/dictionary/scripts/import-dictionaries.ts",
    "dict:import:single": "tsx src/lib/dictionary/scripts/import-single-dictionary.ts",
    "dict:test": "jest src/lib/dictionary/__tests__/ --watch",
    "dict:examples": "tsx src/lib/dictionary/examples/dictionary-import-examples.ts",
    "dict:setup": "bash src/lib/dictionary/scripts/setup.sh"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@dagrejs/dagre": "^1.1.8",
    "@hookform/resolvers": "^7.0.6",
    "@indic-transliteration/sanscript": "^1.3.3",
    "@next/bundle-analyzer": "^16.4.6",
    "@prisma/client": "^6.19.3",
    "@react-email/components": "^1.0.12",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/zod-form-adapter": "^0.42.1",
    "@xyflow/react": "^12.12.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "file-saver": "^2.0.5",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "input-otp": "^1.5.0",
    "jotai": "^3.0.2",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.73.0",
    "mime": "^4.1.2",
    "nanoid": "^6.0.2",
    "next": "^16.4.6",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "otpauth": "^9.6.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-datepicker": "^8.10.0",
    "react-day-picker": "9.14.0",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.2.0",
    "react-force-graph-3d": "^1.29.2",
    "react-hook-form": "^7.92.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.6",
    "react-use-audio-player": "^4.0.2",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "resend": "^6.38.1",
    "sharp": "0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "three-spritetext": "^1.10.0",
    "usehooks-ts": "^3.1.1",
    "vaul": "^1.1.2",
    "webime": "^1.0.2",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "autoprefixer": "^10.6.2",
    "baseline-browser-mapping": "^2.11.37",
    "better-sqlite3": "^12.11.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "graphology-types": "^0.24.8",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^6.19.3",
    "react-email": "^6.11.13",
    "tailwindcss": "^4.3.5",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "arrowParens": "always",
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "all"
  },
  "pnpm": {
    "overrides": {
      "magic-string": "^0.30.21"
    }
  }
}