# Ask AI: any OpenAI-compatible chat endpoint (OpenAI, Ollama, LM Studio, vLLM, OpenRouter...)
# AI_BASE_URL="http://localhost:11434/v1"
# AI_MODEL="llama3.1"
# AI_API_KEY="---" # optional for local servers
# AI knowledge index (semantic search + knowledge graph, built per book or
# chapter from the "AI knowledge index" button). Embeddings come from any
# OpenAI-compatible /embeddings endpoint; multilingual models suit Sanskrit.
# AI_EMBED_MODEL="nomic-embed-text-v2-moe"
# AI_EMBED_BASE_URL="http://localhost:11434/v1" # defaults to AI_BASE_URL
# AI_EMBED_API_KEY="---" # defaults to AI_API_KEY
# AI_EMBED_DIMENSIONS="1024" # optional, only for Matryoshka models; changing it needs a rebuild
# AI_EMBED_QUERY_PREFIX="search_query: " # optional, model specific
# AI_EMBED_DOCUMENT_PREFIX="search_document: " # optional; changing it needs a rebuild
# The knowledge graph is read by the chat model. A smaller model and no
# "thinking" make long books practical.
# AI_RAG_MODEL="llama3.1" # defaults to AI_MODEL
# AI_RAG_REASONING_EFFORT="none" # optional, for reasoning models
# AI_RAG_CONCURRENCY="1" # parallel requests, if the server can take them
# Ask AI voice input: optional local OpenAI-compatible speech-to-text server
# (whisper.cpp server, Speaches, LocalAI...). Without it the browser's own
# speech recognition is used.
# AI_STT_BASE_URL="http://localhost:8000/v1"
# AI_STT_MODEL="whisper-1"
# AI_STT_API_KEY="---" # optional
# Reading answers aloud tries TTS_UTILS_URL above, then this OpenAI-compatible
# /audio/speech model (e.g. Ollama "phonon"), then the browser's own voices.
# AI_TTS_MODEL="phonon"
# AI_TTS_BASE_URL="http://localhost:11434/v1" # defaults to AI_BASE_URL
# AI_TTS_VOICE="" # optional
# AI_TTS_API_KEY="---" # optional

POSTGRES_URL="postgres://user:pwd@host.us-east-1.aws.neon.tech:5432/db?sslmode=require"
POSTGRES_PRISMA_URL="postgres://user:pwd@host.us-east-1.aws.neon.tech:5432/db?sslmode=require&pgbouncer=true&connect_timeout=15"
POSTGRES_URL_NO_SSL="postgres://user:pwd@host.us-east-1.aws.neon.tech:5432/db"
POSTGRES_URL_NON_POOLING="postgres://user:pwd@host.us-east-1.aws.neon.tech:5432/db?sslmode=require"
POSTGRES_USER="user"
POSTGRES_HOST="host.us-east-1.aws.neon.tech"
POSTGRES_PASSWORD="pwd"
POSTGRES_DATABASE="db"
