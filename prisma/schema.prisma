generator client {
  provider = "prisma-client-js"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//********** AuthJS Begin **********//
enum UserRole {
  USER
  ADMIN
  MEMBER // Legacy role - consider migrating to USER
}

model User {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole        @default(USER)
  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]

  // TOTP (Time-based One-Time Password) fields
  totpSecret      String? // Encrypted TOTP secret
  totpEnabled     Boolean  @default(false)
  totpBackupCodes String[] @default([]) // Array of hashed backup codes

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  // AI model used when none is picked for a request; null = the app default
  aiProviderId String?
  aiModel      String?

  Playlist    Playlist[]
  SavedSearch SavedSearch[]
  AiChat      AiChat[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
  @@index([expires])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @id @map("_id")
  userId               String  @db.ObjectId
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialID])
  @@index([userId, providerAccountId])
}

//********** AuthJS End **********//

//********** Entities Begin **********//

model Entity {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  order          Int                  @default(0)
  type           String
  imageThumbnail String?              @default("")
  bookmarked     Boolean              @default(false)
  audio          String?              @default("")
  text           LanguageValueType[]
  meaning        LanguageValueType[]
  attributes     AttributeValueType[]
  notes          String?              @default("")

  parentsRel Entity[] @relation("EntityRels", fields: [parents], references: [id])
  parents    String[] @db.ObjectId

  childrenRel Entity[] @relation("EntityRels", fields: [children], references: [id])
  children    String[] @db.ObjectId

  // rootEntity   Entity   @relation("RootEntityRels", fields: [rootEntityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // rootEntityId String   @db.ObjectId
  // allChildren  Entity[] @relation("RootEntityRels")

  annotations EntityAnnotation[]
  playgrounds EntityPlayground[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Listing the children of a parent in reading order is the hottest query
  // (every chapter page, prev/next navigation); this index serves it without
  // loading and sorting all siblings. It also covers lookups by parent alone.
  @@index([parents, order])
  // Browsing a type (all deities, all stotrams) in order.
  @@index([type, order])
  @@index([type, bookmarked, updatedAt(sort: Desc)])
  @@index([children])
  @@index([audio])
  @@index([bookmarked, updatedAt(sort: Desc)])
  @@index([type, updatedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@fulltext([order, type, text, meaning])
  @@map("Entities")
}

// Commentaries, personal thoughts and any other long-form writing about an
// entity (a verse, a chapter, a book). Kept out of the Entity document so a
// verse can carry any number of them, in any language, without making the
// list queries heavier. `kind` is an open string — see src/lib/annotations.ts.
model EntityAnnotation {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  entityId String  @db.ObjectId
  entity   Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  kind     String
  language String
  // commentator, source or heading
  title    String? @default("")
  // markdown
  text     String
  order    Int     @default(0)
  // who wrote it; private kinds (thoughts) are only shown to this user
  userId   String? @db.ObjectId
  // Set when an importer wrote it (e.g. "sanskritsahitya:mn"); a rebuild
  // replaces only its own annotations. Editing one by hand makes it
  // "edited:sanskritsahitya:mn", which a rebuild keeps and does not re-add.
  source   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityId, kind, order])
  @@index([userId, kind, updatedAt(sort: Desc)])
  @@map("EntityAnnotations")
}

// A saved Sanskrit playground canvas for an entity (normally a verse): the
// tools that were run on its text and what they returned. A verse can keep
// any number of these, one per line of analysis being explored.
model EntityPlayground {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  entityId String  @db.ObjectId
  entity   Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  title    String
  // React Flow nodes and edges, as the playground store snapshots them
  nodes    Json
  edges    Json
  // who saved it
  userId   String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityId, updatedAt(sort: Desc)])
  @@map("EntityPlaygrounds")
}

type TypeEntityType {
  type   String
  entity String @db.ObjectId
}

model EntityType {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  code        String              @unique
  name        LanguageValueType[]
  description String?             @default("")
  // createdAt   DateTime            @default(now())
  // updatedAt   DateTime            @updatedAt

  @@map("EntityTypes")
}

//********** Sanskrit Sahitya Begin **********//
// Works from data/sanskritsahitya-com-data move through two stages, like
// the dictionaries:  source JSON ──capture──▶ SahityaRawRecords ──build──▶ Entities
// See src/lib/sahitya/README.md.

// One per work (a folder of the data repository): where its originals came
// from and the state of the two stages.
model SahityaSource {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  // folder / file base name, e.g. "ramayanam" (also the sanskritsahitya.org path)
  work            String    @unique
  title           String
  // source files in reading order, relative to the data directory
  files           String[]
  // size + mtime of every file at capture, to spot changed sources
  sourceSignature String?
  // git commit of the data repository at capture, when it is a checkout
  sourceRevision  String?
  // everything in the source except the data rows (title, custom, terms,
  // books, chapters and any keys added later), untouched
  header          Json?     @db.Json
  // { field: count } over all data rows at the last capture
  fieldStats      Json?     @db.Json
  rawCount        Int       @default(0)
  capturedAt      DateTime?
  // build options (entityType, parentId, bookmarkAll) used last time
  options         Json?     @db.Json
  rootEntityId    String?   @db.ObjectId
  entityCount     Int       @default(0)
  builtAt         DateTime?
  builtVersion    Int?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("SahityaSources")
}

// Every book, chapter and data row of a work exactly as it is in the source,
// so entities can be rebuilt at any time without the source files.
model SahityaRawRecord {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  work        String
  // stable key within the work: "b:1", "c:1.2", "v:1.2:17", "t:1.2:17:1"
  key         String
  // "book" | "chapter" | "row"
  kind        String
  // reading order across the whole work (books, then chapters, then rows)
  seq         Int
  // chapter number of a row, or the number of a book / chapter
  ref         String?
  // source file the row came from
  file        String?
  // the source object, every key, untouched
  row         Json     @db.Json
  // hash of row, to tell changed rows on a re-capture
  hash        String
  // capture run that last saw this record
  runId       String?
  // no longer in the source; its entity is removed by the next build
  removed     Boolean  @default(false)
  // build plan: parent record key ("" = the work's root) and position under it
  parentKey   String?
  pos         Int?
  // entity built from this record, and a hash of what was written to it
  // (a different hash on the entity now means it was edited by hand)
  entityId    String?  @db.ObjectId
  builtHash   String?
  builtVersion Int?
  importedAt  DateTime @default(now())

  @@unique([work, key], map: "sahitya_raw_work_key_uq")
  @@index([work, seq], map: "sahitya_raw_work_seq_idx")
  @@index([work, runId], map: "sahitya_raw_work_run_idx")
  @@index([entityId], map: "sahitya_raw_entity_idx")
  @@map("SahityaRawRecords")
}
//********** Sanskrit Sahitya End **********//

//********** Entities End **********//

//********** Extras Begin **********//
model Language {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  iso       String  @unique
  name      String
  direction String? @default("")
  // createdAt DateTime @default(now())
  // updatedAt DateTime @updatedAt

  @@map("Languages")
}

//********** Extras End **********//

//********** Dictionary Begin **********//
model DictionaryWord {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  wordIndex   Int
  wordLnum    Int?                 @default(0) // Line number in the source text, if applicable
  origin      String
  word        LanguageValueType[]
  description LanguageValueType[]
  attributes  AttributeValueType[]
  phonetic    String
  // Imported entries: a small pointer to the original row in DictRawEntries
  // ({ key, table, lnum }). Older imports hold the whole original row here.
  sourceData  Json?                @db.Json
  // Key of the original row in DictRawEntries (origin + sourceKey)
  sourceKey   String?
  // Every word of the headword and the whole meaning, in every script, for
  // the full-text index. Never returned to readers.
  searchText  String?
  // Processor version that built this entry; older versions need a rebuild
  processorVersion Int?
  // Set when someone edits or adds the entry by hand; rebuilds keep it
  editedAt    DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([wordIndex, origin])
  // Core indexes optimized for different search patterns
  @@index([origin, wordIndex(sort: Asc)], map: "origin_wordIndex_asc_idx")
  @@index([origin, wordIndex(sort: Desc)], map: "origin_wordIndex_desc_idx")
  @@index([origin, phonetic], map: "origin_phonetic_idx")
  @@index([origin, sourceKey], map: "origin_sourceKey_idx")
  // Headword lookups match word.value with anchored regexes
  @@index([word.value], map: "word_value_idx")
  // Full-text ("meaning") search over the whole entry
  @@fulltext([phonetic, searchText], map: "dict_fulltext_idx")
  @@map("DictWords")
}

// One per dictionary: where its originals came from and the state of the
// two stages (originals captured → search entries built).
model DictionarySource {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  origin           String    @unique
  // Source file and table the originals were captured from
  sourceFile       String?
  sourceTable      String?
  columns          String[]
  // "rowid" or the column used as each row's key (e.g. "lnum")
  keyColumn        String?
  // File size + mtime at capture, to spot a changed source file
  sourceSignature  String?
  rawCount         Int       @default(0)
  capturedAt       DateTime?
  // Abbreviations, authorities, source notes from companion tables
  extras           Json?     @db.Json
  entryCount       Int       @default(0)
  builtAt          DateTime?
  builtVersion     Int?
  lastError        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@map("DictSources")
}

// Original dictionary rows exactly as they were in the source, so entries can
// be rebuilt at any time without the source file.
model DictionaryRawEntry {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  origin     String
  // Stable key within the dictionary (lnum where unique, else rowid)
  key        String
  // 1-based position in dictionary order; becomes the entry's wordIndex
  seq        Int
  rowid      Int?
  // Headword as written in the source
  headword   String
  // The source row, every column, untouched
  row        Json     @db.Json
  // Hash of row, to tell changed rows on a re-capture
  hash       String
  // Id of the capture run that last saw this row
  runId      String?
  importedAt DateTime @default(now())

  @@unique([origin, key], map: "raw_origin_key_uq")
  @@index([origin, seq, key], map: "raw_origin_seq_idx")
  @@index([origin, headword], map: "raw_origin_headword_idx")
  @@index([origin, runId], map: "raw_origin_run_idx")
  @@map("DictRawEntries")
}

type LanguageValueType {
  language String @map("lang") // lanugage is a reserved keyword
  value    String
}

type AttributeValueType {
  key   String
  value String
}

//********** Dictionary End **********//

//********** SavedSearch Begin **********//
model SavedSearch {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  name      String
  queryText String
  filters   Json?    @db.Json // Flexible filter storage (origin, language, wordLength, hasAudio, etc.)
  sortBy    String?  @default("relevance")
  sortOrder String?  @default("desc")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@map("SavedSearches")
}

//********** SavedSearch End **********//

//********** AI Chat Begin **********//
// One "Ask AI" conversation. Turns are embedded: a chat is always read and
// written whole, and stays far below the document size limit.
model AiChat {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  // book, chapter or verse the chat stays within; null for the whole library
  scopeId   String?          @db.ObjectId
  turns     TypeAiChatTurn[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, scopeId, updatedAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("AiChats")
}

type TypeAiChatTurn {
  question  String
  answer    String
  sources   TypeAiChatSource[]
  mode      String?
  error     String?
  createdAt DateTime           @default(now())
}

type TypeAiChatSource {
  n         Int
  id        String
  type      String
  parentId  String?
  reference String
}

//********** AI Chat End **********//

//********** AI Knowledge Index (RAG) Begin **********//
// What "Ask AI" and the Universe view know about one entity (a verse or a
// container): its embedding for semantic search, and the characters, concepts,
// places and states of mind it mentions. Built on demand for a book, a chapter
// or the whole library — see src/lib/ai/rag/build.ts.
model RagChunk {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  entityId  String           @unique @db.ObjectId
  // the container the entity sits in; scopes are resolved to container ids
  parentId  String?          @db.ObjectId
  type      String
  order     Int              @default(0)
  // hash of the embedded text, to skip unchanged entities on a rebuild
  hash      String           @default("")
  model     String           @default("")
  dim       Int              @default(0)
  // unit vector, quantised to one signed byte per dimension
  vector    Bytes?
  // hash of the text the mentions were extracted from; null = not extracted
  graphHash String?
  mentions  TypeRagMention[]

  updatedAt DateTime @updatedAt

  @@index([parentId, order])
  @@index([mentions.key])
  @@map("RagChunks")
}

type TypeRagMention {
  // RagConcept.key
  key String
  // MENTIONS | DEFINES | SPOKEN_BY | ADDRESSES | DEPICTS
  rel String
  why String?
}

// A character, concept, place or state of mind found by the model. Shared by
// every book that mentions it, so the same person links texts together.
model RagConcept {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  // "<kind>:<slug>", e.g. "character:hanuman"
  key         String   @unique
  kind        String
  label       String
  // name in the original script, when the model gave one
  original    String?  @default("")
  description String   @default("")
  aliases     String[] @default([])
  // how many indexed entities mention it
  count       Int      @default(0)
  model       String   @default("")
  vector      Bytes?

  updatedAt DateTime @updatedAt

  @@index([kind, count(sort: Desc)])
  @@map("RagConcepts")
}

// A stated relation between two concepts ("son of", "leads to"), grounded in
// the entity it was read from.
model RagRelation {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  from     String
  to       String
  label    String
  why      String? @default("")
  entityId String  @db.ObjectId
  parentId String? @db.ObjectId

  @@index([from])
  @@index([to])
  @@index([parentId])
  @@index([entityId])
  @@map("RagRelations")
}

// One run of the index builder over a scope. Progress is written here so any
// browser can follow it; `heartbeatAt` tells a live run from an interrupted one.
model RagBuild {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  // null = the whole library
  scopeId    String? @db.ObjectId
  scopeTitle String  @default("")
  userId     String  @db.ObjectId
  // queued | running | done | failed | cancelled
  status     String
  // embed | graph | concepts
  stage      String  @default("")
  embeddings Boolean @default(true)
  graph      Boolean @default(false)
  force      Boolean @default(false)
  total      Int     @default(0)
  done       Int     @default(0)
  embedded   Int     @default(0)
  extracted  Int     @default(0)
  failed     Int     @default(0)
  message    String? @default("")
  error      String?
  cancel     Boolean @default(false)

  startedAt   DateTime  @default(now())
  heartbeatAt DateTime  @default(now())
  finishedAt  DateTime?

  @@index([scopeId, startedAt(sort: Desc)])
  @@index([status, heartbeatAt])
  @@map("RagBuilds")
}

//********** AI Knowledge Index (RAG) End **********//

//********** AI Providers Begin **********//

// A chat model endpoint the app can send AI requests to. Any number can be
// configured (Settings › AI); the one used is picked per request, falling
// back to the user's and then the app's default.
model AiProvider {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  // openai (any OpenAI-compatible /chat/completions endpoint) | anthropic
  kind         String
  // empty for anthropic = the official endpoint
  baseUrl      String   @default("")
  // encrypted with TOTP_ENCRYPTION_KEY; never sent to the browser
  apiKey       String?
  // model names offered in the picker, as the provider knows them
  models       String[] @default([])
  defaultModel String   @default("")
  enabled      Boolean  @default(true)
  order        Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("AiProviders")
}

// One run of "fill with AI" over a book or chapter: meanings, word-by-word
// meanings and web-researched explanations written verse by verse. Progress
// lives here so any browser can follow it, like RagBuild.
model AiFillJob {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  scopeId    String  @db.ObjectId
  scopeTitle String  @default("")
  userId     String  @db.ObjectId
  // queued | running | done | failed | cancelled
  status     String
  meaning    Boolean @default(false)
  words      Boolean @default(false)
  schools    Boolean @default(false)
  // replace what is already there instead of filling only the gaps
  overwrite  Boolean @default(false)
  // language the meanings and explanations are written in
  language   String
  providerId String
  model      String
  total      Int     @default(0)
  done       Int     @default(0)
  filled     Int     @default(0)
  skipped    Int     @default(0)
  failed     Int     @default(0)
  message    String? @default("")
  error      String?
  cancel     Boolean @default(false)

  startedAt   DateTime  @default(now())
  heartbeatAt DateTime  @default(now())
  finishedAt  DateTime?

  @@index([scopeId, startedAt(sort: Desc)])
  @@index([status, heartbeatAt])
  @@map("AiFillJobs")
}

//********** AI Providers End **********//

//********** Playlist Begin **********//
model Playlist {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  image     String?        @default("")
  isPublic  Boolean        @default(false)
  // Reference to the user who created the playlist
  userId    String         @db.ObjectId
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Many-to-many relationship with Entity
  songs     PlaylistSong[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
  @@map("Playlists")
}

model PlaylistSong {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  // Reference to the playlist
  playlistId String   @db.ObjectId
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  // Asset Path
  src        String
  // Item-specific attributes
  order      Int      @default(0)
  addedAt    DateTime @default(now())

  @@index([playlistId, order])
  @@map("PlaylistSongs")
}

//********** Playlist End **********//

//********** App Settings Begin **********//
model AppSettings {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Signup restriction settings
  restrictSignup       Boolean  @default(false)
  allowedSignupEmails  String[] @default([])
  allowedSignupDomains String[] @default([])

  // AI model used when a user has not chosen one ("env" = the provider set
  // through AI_BASE_URL / AI_MODEL)
  aiProviderId    String?
  aiModel         String?
  // Web search behind "search the web for explanations":
  // duckduckgo | tavily | brave | searxng
  webSearchEngine String?
  // SearXNG instance
  webSearchUrl    String?
  // encrypted, like AiProvider.apiKey
  webSearchApiKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("AppSettings")
}

//********** App Settings End **********//
