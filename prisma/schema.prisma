generator client {
  provider = "prisma-client-js"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

//********** AuthJS Begin **********//
enum UserRole {
  USER
  ADMIN
  MEMBER // Legacy role - consider migrating to USER
}

model User {
  id            String          @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          UserRole        @default(USER)
  accounts      Account[]
  sessions      Session[]
  // Optional for WebAuthn support
  Authenticator Authenticator[]

  // TOTP (Time-based One-Time Password) fields
  totpSecret      String? // Encrypted TOTP secret
  totpEnabled     Boolean  @default(false)
  totpBackupCodes String[] @default([]) // Array of hashed backup codes

  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  Playlist    Playlist[]
  SavedSearch SavedSearch[]
  AiChat      AiChat[]
}

model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expires])
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@index([identifier])
  @@index([expires])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @id @map("_id")
  userId               String  @db.ObjectId
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialID])
  @@index([userId, providerAccountId])
}

//********** AuthJS End **********//

//********** Entities Begin **********//

model Entity {
  id             String               @id @default(auto()) @map("_id") @db.ObjectId
  order          Int                  @default(0)
  type           String
  imageThumbnail String?              @default("")
  bookmarked     Boolean              @default(false)
  audio          String?              @default("")
  text           LanguageValueType[]
  meaning        LanguageValueType[]
  attributes     AttributeValueType[]
  notes          String?              @default("")

  parentsRel Entity[] @relation("EntityRels", fields: [parents], references: [id])
  parents    String[] @db.ObjectId

  childrenRel Entity[] @relation("EntityRels", fields: [children], references: [id])
  children    String[] @db.ObjectId

  // rootEntity   Entity   @relation("RootEntityRels", fields: [rootEntityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  // rootEntityId String   @db.ObjectId
  // allChildren  Entity[] @relation("RootEntityRels")

  annotations EntityAnnotation[]
  playgrounds EntityPlayground[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Listing the children of a parent in reading order is the hottest query
  // (every chapter page, prev/next navigation); this index serves it without
  // loading and sorting all siblings. It also covers lookups by parent alone.
  @@index([parents, order])
  // Browsing a type (all deities, all stotrams) in order.
  @@index([type, order])
  @@index([type, bookmarked, updatedAt(sort: Desc)])
  @@index([children])
  @@index([audio])
  @@index([bookmarked, updatedAt(sort: Desc)])
  @@index([type, updatedAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@fulltext([order, type, text, meaning])
  @@map("Entities")
}

// Commentaries, personal thoughts and any other long-form writing about an
// entity (a verse, a chapter, a book). Kept out of the Entity document so a
// verse can carry any number of them, in any language, without making the
// list queries heavier. `kind` is an open string — see src/lib/annotations.ts.
model EntityAnnotation {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  entityId String  @db.ObjectId
  entity   Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  kind     String
  language String
  // commentator, source or heading
  title    String? @default("")
  // markdown
  text     String
  order    Int     @default(0)
  // who wrote it; private kinds (thoughts) are only shown to this user
  userId   String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityId, kind, order])
  @@index([userId, kind, updatedAt(sort: Desc)])
  @@map("EntityAnnotations")
}

// A saved Sanskrit playground canvas for an entity (normally a verse): the
// tools that were run on its text and what they returned. A verse can keep
// any number of these, one per line of analysis being explored.
model EntityPlayground {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  entityId String  @db.ObjectId
  entity   Entity  @relation(fields: [entityId], references: [id], onDelete: Cascade)
  title    String
  // React Flow nodes and edges, as the playground store snapshots them
  nodes    Json
  edges    Json
  // who saved it
  userId   String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([entityId, updatedAt(sort: Desc)])
  @@map("EntityPlaygrounds")
}

type TypeEntityType {
  type   String
  entity String @db.ObjectId
}

model EntityType {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  code        String              @unique
  name        LanguageValueType[]
  description String?             @default("")
  // createdAt   DateTime            @default(now())
  // updatedAt   DateTime            @updatedAt

  @@map("EntityTypes")
}

//********** Entities End **********//

//********** Extras Begin **********//
model Language {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  iso       String  @unique
  name      String
  direction String? @default("")
  // createdAt DateTime @default(now())
  // updatedAt DateTime @updatedAt

  @@map("Languages")
}

//********** Extras End **********//

//********** Dictionary Begin **********//
model DictionaryWord {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  wordIndex   Int
  wordLnum    Int?                 @default(0) // Line number in the source text, if applicable
  origin      String
  word        LanguageValueType[]
  description LanguageValueType[]
  attributes  AttributeValueType[]
  phonetic    String
  sourceData  Json?                @db.Json
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([wordIndex, origin])
  // Core indexes optimized for different search patterns
  @@index([origin, wordIndex(sort: Asc)], map: "origin_wordIndex_asc_idx")
  @@index([origin, wordIndex(sort: Desc)], map: "origin_wordIndex_desc_idx")
  @@index([origin, phonetic], map: "origin_phonetic_idx")
  @@index([origin, word], map: "origin_word_idx")
  // Combined full-text search index for both phonetic and word content
  @@fulltext([phonetic, word], map: "phonetic_word_text_idx")
  @@map("DictWords")
}

type LanguageValueType {
  language String @map("lang") // lanugage is a reserved keyword
  value    String
}

type AttributeValueType {
  key   String
  value String
}

//********** Dictionary End **********//

//********** SavedSearch Begin **********//
model SavedSearch {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  name      String
  queryText String
  filters   Json?    @db.Json // Flexible filter storage (origin, language, wordLength, hasAudio, etc.)
  sortBy    String?  @default("relevance")
  sortOrder String?  @default("desc")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt(sort: Desc)])
  @@map("SavedSearches")
}

//********** SavedSearch End **********//

//********** AI Chat Begin **********//
// One "Ask AI" conversation. Turns are embedded: a chat is always read and
// written whole, and stays far below the document size limit.
model AiChat {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  // book, chapter or verse the chat stays within; null for the whole library
  scopeId   String?          @db.ObjectId
  turns     TypeAiChatTurn[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId, scopeId, updatedAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("AiChats")
}

type TypeAiChatTurn {
  question  String
  answer    String
  sources   TypeAiChatSource[]
  mode      String?
  error     String?
  createdAt DateTime           @default(now())
}

type TypeAiChatSource {
  n         Int
  id        String
  type      String
  parentId  String?
  reference String
}

//********** AI Chat End **********//

//********** AI Knowledge Index (RAG) Begin **********//
// What "Ask AI" and the Universe view know about one entity (a verse or a
// container): its embedding for semantic search, and the characters, concepts,
// places and states of mind it mentions. Built on demand for a book, a chapter
// or the whole library — see src/lib/ai/rag/build.ts.
model RagChunk {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  entityId  String           @unique @db.ObjectId
  // the container the entity sits in; scopes are resolved to container ids
  parentId  String?          @db.ObjectId
  type      String
  order     Int              @default(0)
  // hash of the embedded text, to skip unchanged entities on a rebuild
  hash      String           @default("")
  model     String           @default("")
  dim       Int              @default(0)
  // unit vector, quantised to one signed byte per dimension
  vector    Bytes?
  // hash of the text the mentions were extracted from; null = not extracted
  graphHash String?
  mentions  TypeRagMention[]

  updatedAt DateTime @updatedAt

  @@index([parentId, order])
  @@index([mentions.key])
  @@map("RagChunks")
}

type TypeRagMention {
  // RagConcept.key
  key String
  // MENTIONS | DEFINES | SPOKEN_BY | ADDRESSES | DEPICTS
  rel String
  why String?
}

// A character, concept, place or state of mind found by the model. Shared by
// every book that mentions it, so the same person links texts together.
model RagConcept {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  // "<kind>:<slug>", e.g. "character:hanuman"
  key         String   @unique
  kind        String
  label       String
  // name in the original script, when the model gave one
  original    String?  @default("")
  description String   @default("")
  aliases     String[] @default([])
  // how many indexed entities mention it
  count       Int      @default(0)
  model       String   @default("")
  vector      Bytes?

  updatedAt DateTime @updatedAt

  @@index([kind, count(sort: Desc)])
  @@map("RagConcepts")
}

// A stated relation between two concepts ("son of", "leads to"), grounded in
// the entity it was read from.
model RagRelation {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  from     String
  to       String
  label    String
  why      String? @default("")
  entityId String  @db.ObjectId
  parentId String? @db.ObjectId

  @@index([from])
  @@index([to])
  @@index([parentId])
  @@index([entityId])
  @@map("RagRelations")
}

// One run of the index builder over a scope. Progress is written here so any
// browser can follow it; `heartbeatAt` tells a live run from an interrupted one.
model RagBuild {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  // null = the whole library
  scopeId    String? @db.ObjectId
  scopeTitle String  @default("")
  userId     String  @db.ObjectId
  // queued | running | done | failed | cancelled
  status     String
  // embed | graph | concepts
  stage      String  @default("")
  embeddings Boolean @default(true)
  graph      Boolean @default(false)
  force      Boolean @default(false)
  total      Int     @default(0)
  done       Int     @default(0)
  embedded   Int     @default(0)
  extracted  Int     @default(0)
  failed     Int     @default(0)
  message    String? @default("")
  error      String?
  cancel     Boolean @default(false)

  startedAt   DateTime  @default(now())
  heartbeatAt DateTime  @default(now())
  finishedAt  DateTime?

  @@index([scopeId, startedAt(sort: Desc)])
  @@index([status, heartbeatAt])
  @@map("RagBuilds")
}

//********** AI Knowledge Index (RAG) End **********//

//********** Playlist Begin **********//
model Playlist {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  image     String?        @default("")
  isPublic  Boolean        @default(false)
  // Reference to the user who created the playlist
  userId    String         @db.ObjectId
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Many-to-many relationship with Entity
  songs     PlaylistSong[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
  @@map("Playlists")
}

model PlaylistSong {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  // Reference to the playlist
  playlistId String   @db.ObjectId
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  // Asset Path
  src        String
  // Item-specific attributes
  order      Int      @default(0)
  addedAt    DateTime @default(now())

  @@index([playlistId, order])
  @@map("PlaylistSongs")
}

//********** Playlist End **********//

//********** App Settings Begin **********//
model AppSettings {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  // Signup restriction settings
  restrictSignup       Boolean  @default(false)
  allowedSignupEmails  String[] @default([])
  allowedSignupDomains String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("AppSettings")
}

//********** App Settings End **********//
